---
import { Image } from "astro:assets";
import aboutImg from "@/assets/about-astro.png";
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Learn more about the author of this blog.",
	title: "About",
};
---

<PageLayout meta={meta}>
	<div class="space-y-6">
		<h1 class="title">About</h1>
		<p>
			Hey there! I'm thrilled you've stopped by. I'm a passionate coder with a love for all things
			tech, especially blockchains and command-line interfaces. When I'm not immersed in lines of
			code, you'll find me sipping on a warm cup of tea, tinkering with hobby projects, or diving
			into the latest PS5 game. I also enjoy the occasional swim and love exploring coastal islands
			- there's something magical about the sea breeze and sandy shores! I'm always excited to chat
			about coding, gaming, or any of my adventures, so feel free to reach out!
		</p>
		<div class="flex justify-center">
			<Image
				alt="A cartoon cactus looking at the 'Astro.build' logo"
				fetchpriority="high"
				loading="eager"
				src={aboutImg}
			/>
		</div>
		<p>
			Want to connect or see what I'm working on? Check out my <a
				aria-label="github repository"
				class="cactus-link inline-block"
				href="https://github.com/itsyaasir"
				rel="noreferrer"
				target="_blank">GitHub</a
			> for my latest projects!
		</p>
	</div>
</PageLayout>
