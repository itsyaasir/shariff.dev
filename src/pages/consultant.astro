---
import PageTitle from "@/components/PageTitle.astro";
import Base from "@/layouts/Base.astro";

const meta = {
	title: "Consulting",
	description:
		"Consulting with Yasir Shariff on Rust and blockchain infrastructure, distributed backends, and production software products.",
};

const coreSkills = [
	{ name: "Rust", description: "Proof systems, command-line tools, libraries, and WebAssembly" },
	{ name: "Blockchain", description: "Execution clients, RPC services, and developer tooling" },
	{ name: "Distributed systems", description: "Backend services, routing, failover, and real-time data" },
];

const selectedWork = [
	{ name: "IOTA", description: "Notarization, audit trails, and proof of inclusion" },
	{ name: "Tideblock", description: "Low-latency Solana RPC routing and failover" },
	{ name: "Bitfinity Network", description: "Ethereum-compatible execution and JSON-RPC" },
];

const toolsAndFrameworks = [
	{ name: "Rust and Move", description: "Protocol and application libraries" },
	{ name: "TypeScript and WebAssembly", description: "Developer interfaces and integrations" },
	{ name: "PostgreSQL", description: "Application data and backend services" },
	{ name: "Redpanda and Kafka", description: "Event-driven data processing" },
	{ name: "WebSockets and Protocol Buffers", description: "Real-time communication" },
];
---

<Base meta={meta}>
	<div class="space-y-6">
		<PageTitle>
			<h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Consultancy Services</h1>
		</PageTitle>

		<div class="prose prose-sm prose-cactus mt-12">
			<section class="mb-8">
				<h2 class="mb-4 text-xl font-semibold">What I Offer</h2>
				<p class="mb-4">
					I help teams design, build, and support software where correct behavior and reliable
					operation matter. My work spans blockchain protocols, distributed infrastructure, and
					products used in daily business operations.
				</p>
				<ul class="list-disc space-y-2 pl-6">
					<li>Rust libraries, proof systems, and developer tooling</li>
					<li>Blockchain execution, RPC, and integration work</li>
					<li>Distributed backends, routing, and failover</li>
					<li>Product architecture and delivery</li>
					<li>Testing, performance analysis, and production troubleshooting</li>
				</ul>
			</section>

			<section class="mb-12">
				<h2 class="mb-6 text-xl font-semibold">Technical Expertise</h2>

				<!-- Core Skills -->
				<div class="mb-8">
					<h3 class="mb-3 text-lg font-medium">Core Technologies</h3>
					<ul class="list-disc space-y-2 pl-6">
						{
							coreSkills.map((skill) => (
								<li>
									<span class="font-medium">{skill.name}</span> - {skill.description}
								</li>
							))
						}
					</ul>
				</div>

				<div class="mb-8">
					<h3 class="mb-3 text-lg font-medium">Selected Work</h3>
					<ul class="list-disc space-y-2 pl-6">
						{
							selectedWork.map((skill) => (
								<li>
									<span class="font-medium">{skill.name}</span> - {skill.description}
								</li>
							))
						}
					</ul>
				</div>

				<div class="mb-8">
					<h3 class="mb-3 text-lg font-medium">Tools & Frameworks</h3>
					<ul class="list-disc space-y-2 pl-6">
						{
							toolsAndFrameworks.map((skill) => (
								<li>
									<span class="font-medium">{skill.name}</span> - {skill.description}
								</li>
							))
						}
					</ul>
				</div>
			</section>

			<section class="mb-8">
				<h2 class="mb-4 text-xl font-semibold">Why Work With Me</h2>
				<ul class="list-disc space-y-2 pl-6">
					<li>
						<span class="font-medium">End-to-end ownership</span> - I take work from architecture and
						implementation through testing, documentation, release, and production support.
					</li>
					<li>
						<span class="font-medium">Protocol and systems experience</span> - My work includes Rust
						proof infrastructure, an Ethereum-compatible execution client, and Solana RPC services.
					</li>
					<li>
						<span class="font-medium">Product perspective</span> - Through Shariff Consultancy, I build
						and operate Shipzen and PrismPOS, production products for logistics and business operations.
					</li>
				</ul>
			</section>

			<section class="mb-8">
				<h2 class="mb-4 text-xl font-semibold">Get in Touch</h2>
				<p class="mb-4">
					Tell me what you're building and where you need help. You can <a
						href="mailto:yasir@shariff.dev?subject=Consulting%20inquiry"
						class="text-link">email me</a
					> or visit <a
						href="https://shariffconsultancy.com"
						target="_blank"
						rel="noopener noreferrer"
						class="text-link">Shariff Consultancy</a
					>.
				</p>
			</section>
		</div>
	</div>
</Base>
