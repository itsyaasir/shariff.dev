---
import PostPreview from "@/components/blog/PostPreview.astro";
import SocialList from "@/components/SocialList.astro";
import { getAllPosts, sortMDByDate } from "@/data/post";
import PageLayout from "@/layouts/Base.astro";

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);
---

<PageLayout meta={{ title: "Home" }}>
	<section>
		<h1 class="title mb-6">Jambo 👋</h1>
		<p class="mb-4">
			I'm Yasir, a Software Engineer in Nairobi. I build Rust and blockchain infrastructure that has
			to be correct and stay up. At IOTA, I lead notarization, audit trails, and proof of inclusion,
			from the Rust core to the WebAssembly and TypeScript APIs developers build on.
		</p>
		<p class="mb-4">
			Through{" "}
			<a
				class="cactus-link"
				data-umami-event="consulting-link"
				data-umami-event-location="home"
				href="/consulting"
			>
				Shariff Consultancy
			</a>
			, I build and run{" "}
			<a
				class="cactus-link"
				data-umami-event="product-click"
				data-umami-event-product="shipzen"
				href="https://shipzen.net"
				rel="noreferrer"
				target="_blank"
			>
				Shipzen
			</a>
			, which ships online shopping from abroad to Kenya, and{" "}
			<a
				class="cactus-link"
				data-umami-event="product-click"
				data-umami-event-product="prismpos"
				href="https://prismpos.app"
				rel="noreferrer"
				target="_blank"
			>
				PrismPOS
			</a>
			, an all-in-one point-of-sale platform for small businesses. I also help teams with Rust,
			protocol code, and distributed backends.
		</p>
		<p class="mb-4">
			Here I write about Rust and the systems behind that work.{" "}
			<a class="cactus-link" href="/about">
				Read more about me
			</a>
			,{" "}
			<a
				class="cactus-link"
				data-umami-event="work-link"
				data-umami-event-location="home"
				href="/work"
			>
				see my work
			</a>
			, or{" "}
			<a
				class="cactus-link"
				data-umami-event="contact-email"
				data-umami-event-location="home"
				href="mailto:yasir@shariff.dev"
			>
				get in touch
			</a>
			.
		</p>
		<SocialList />
	</section>
	<section aria-label="Blog post list" class="mt-16">
		<h2 class="title mb-4 text-xl">Posts</h2>
		<ul class="space-y-4">
			{allPostsByDate.map((p) => (
				<li class="grid gap-2 sm:grid-cols-[auto_1fr] sm:[&_q]:col-start-2">
					{/* @ts-ignore*/}
					<PostPreview post={p} />
				</li>
			))}
		</ul>
	</section>
</PageLayout>
