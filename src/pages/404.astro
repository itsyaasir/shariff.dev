---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "The page you were looking for doesn't exist or has moved.",
	noindex: true,
	title: "Page not found",
};
---

<PageLayout meta={meta}>
	<div class="flex flex-col items-center text-center">
		<h1 class="title mb-6">404 | Page not found</h1>
		<p class="mb-8">
			This page doesn't exist or has moved. Try the{" "}
			<a class="cactus-link" href="/posts/">
				posts
			</a>{" "}
			or head back home.
		</p>

		<a
			href="/"
			class="inline-block border-2 border-accent px-4 py-2 font-semibold text-accent-2 transition-colors hover:bg-accent hover:text-bgColor focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
		>
			Back to home
		</a>
	</div>
</PageLayout>

<script>
	// Umami loads deferred, so wait for it before recording which URL was missing
	window.addEventListener("load", () => {
		window.umami?.track("404", { path: location.pathname });
	});
</script>
