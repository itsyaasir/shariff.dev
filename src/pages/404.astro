---
import PageLayout from "@/layouts/Base.astro";

const meta = {
	description: "Oops! It looks like this page is lost in space!",
	title: "Oops! You found a missing page!",
};
---

<PageLayout meta={meta}>
	<div class="flex flex-col items-center text-center">
		<h1 class="title mb-6">404 | Oops something went wrong</h1>
		<p class="mb-8">Please use the button below to find your way back</p>

		<a
			href="/"
			class="inline-block rounded bg-black px-4 py-2 font-bold text-white hover:bg-gray-800"
		>
			Go Back Home
		</a>
	</div>
</PageLayout>
