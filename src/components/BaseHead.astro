---
import { siteConfig, socialLinks } from "@/site-config";
import type { SiteMeta } from "@/types";
import "../styles/global.css";

type Props = SiteMeta;

const { article, description, noindex, ogImage, title } = Astro.props;

const titleSeparator = "•";
const siteTitle = `${title} ${titleSeparator} ${siteConfig.title}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImageURL = new URL(ogImage ? ogImage : "/social-card/default.png", Astro.url).href;
const xHandle = socialLinks
	.find(({ friendlyName }) => friendlyName === "X")
	?.link.split("/")
	.pop();

// https://developers.google.com/search/docs/appearance/structured-data/article
const siteURL = new URL("/", Astro.site).href;
const person = {
	"@id": `${siteURL}#person`,
	"@type": "Person",
	jobTitle: "Software Engineer",
	name: siteConfig.author,
	sameAs: socialLinks.filter(({ link }) => link.startsWith("https://")).map(({ link }) => link),
	url: siteURL,
};
const website = {
	"@id": `${siteURL}#website`,
	"@type": "WebSite",
	description: siteConfig.description,
	inLanguage: siteConfig.lang,
	name: siteConfig.title,
	publisher: { "@id": person["@id"] },
	url: siteURL,
};
const blogPosting = article && {
	"@type": "BlogPosting",
	author: { "@id": person["@id"] },
	dateModified: article.modifiedTime ?? article.publishedTime,
	datePublished: article.publishedTime,
	description,
	headline: title,
	image: socialImageURL,
	inLanguage: siteConfig.lang,
	isPartOf: { "@id": website["@id"] },
	keywords: article.tags.join(", "),
	mainEntityOfPage: canonicalURL.href,
	publisher: { "@id": person["@id"] },
	url: canonicalURL.href,
};
const jsonLd = {
	"@context": "https://schema.org",
	"@graph": [person, website, ...(blogPosting ? [blogPosting] : [])],
};
---

<meta charset="utf-8" />
<meta content="width=device-width, initial-scale=1.0, shrink-to-fit=no" name="viewport" />
<meta content="IE=edge" http-equiv="X-UA-Compatible" />
<title>{siteTitle}</title>

{/* Icons / Favicon */}
<link href="/favicon.ico" rel="icon" sizes="any" />
<link href="/icon.svg" rel="icon" type="image/svg+xml" />
<link href="/apple-touch-icon.png" rel="apple-touch-icon" />
<link href="/manifest.webmanifest" rel="manifest" />
{noindex ? <meta content="noindex" name="robots" /> : <link href={canonicalURL} rel="canonical" />}

{/* Primary Meta Tags */}
<meta content={description} name="description" />
<meta content={siteConfig.author} name="author" />

{/* Open Graph / Facebook */}
<meta content={article ? "article" : "website"} property="og:type" />
<meta content={title} property="og:title" />
<meta content={description} property="og:description" />
<meta content={canonicalURL} property="og:url" />
<meta content={siteConfig.title} property="og:site_name" />
<meta content={siteConfig.ogLocale} property="og:locale" />
<meta content={socialImageURL} property="og:image" />
<meta content="1200" property="og:image:width" />
<meta content="630" property="og:image:height" />
{article && (
	<>
		<meta content={siteConfig.author} property="article:author" />
		<meta content={article.publishedTime} property="article:published_time" />
		{article.modifiedTime && (
			<meta content={article.modifiedTime} property="article:modified_time" />
		)}
		{article.tags.map((tag) => (
			<meta content={tag} property="article:tag" />
		))}
	</>
)}

{/* Twitter */}
<meta content="summary_large_image" name="twitter:card" />
<meta content={title} name="twitter:title" />
<meta content={description} name="twitter:description" />
<meta content={socialImageURL} name="twitter:image" />
{xHandle && <meta content={`@${xHandle}`} name="twitter:creator" />}

{/* Structured data */}
<script is:inline set:html={JSON.stringify(jsonLd)} type="application/ld+json" />
{/* Sitemap */}
<link href="/sitemap-index.xml" rel="sitemap" />

{/* RSS auto-discovery */}
<link href="/rss.xml" rel="alternate" title={siteConfig.title} type="application/rss+xml" />

{/* Webmentions */}
{siteConfig.webmentions && (
	<>
		<link href={siteConfig.webmentions.link} rel="webmention" />
		{siteConfig.webmentions.pingback && (
			<link href={siteConfig.webmentions.pingback} rel="pingback" />
		)}
	</>
)}

<meta content={Astro.generator} name="generator" />
