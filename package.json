{
	"name": "shariff-dev",
	"version": "1.0.0",
	"packageManager": "pnpm@12.14.0",
	"scripts": {
		"dev": "astro dev",
		"start": "astro dev",
		"build": "astro check && astro build",
		"postbuild": "pagefind --site dist",
		"preview": "astro preview",
		"lint": "biome lint .",
		"format": "pnpm run format:code && pnpm run format:imports",
		"format:code": "biome format . --write && prettier -w \"**/*\" \"!**/*.{md,mdx}\" --ignore-unknown --cache",
		"format:imports": "biome check --formatter-enabled=false --write",
		"check": "astro check",
		"icons": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-icons.mts"
	},
	"dependencies": {
		"@astrojs/markdown-remark": "^7.3.3",
		"@astrojs/mdx": "8.1.0",
		"@astrojs/partytown": "^2.1.8",
		"@astrojs/rss": "4.0.19",
		"@astrojs/sitemap": "3.7.4",
		"astro": "7.4.0",
		"astro-expressive-code": "0.44.2",
		"astro-icon": "^1.2.0",
		"cssnano": "^9.9.0",
		"hastscript": "^9.0.1",
		"mdast-util-directive": "^3.1.1",
		"mdast-util-to-markdown": "^2.2.0",
		"mdast-util-to-string": "^4.0.0",
		"rehype-external-links": "^3.0.0",
		"rehype-unwrap-images": "^1.0.0",
		"remark-directive": "^4.0.0",
		"satori": "0.62.0",
		"satori-html": "^0.3.2",
		"sharp": "^0.35.5",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@biomejs/biome": "^2.5.15",
		"@iconify-json/mdi": "^1.2.3",
		"@pagefind/default-ui": "^1.5.2",
		"@resvg/resvg-js": "^2.6.2",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"pagefind": "^1.5.2",
		"prettier": "^3.9.10",
		"prettier-plugin-astro": "1.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"reading-time": "^1.5.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3"
	}
}
